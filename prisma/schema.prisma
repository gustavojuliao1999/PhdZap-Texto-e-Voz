// Banco do PhdZap.
// As sessões do WhatsApp (chaves do Baileys) continuam em arquivos em DATA_DIR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuário do painel. O super admin não fica aqui: ele entra com a ADMIN_API_KEY do .env.
model User {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  passwordHash String
  /// Administrador: gerencia telefones, usuários e grupos (acesso total aos telefones).
  isAdmin      Boolean       @default(false)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
  groups       GroupMember[]
  sessions     Session[]
}

/// Grupo de usuários com permissões por telefone.
model Group {
  id          String        @id @default(cuid())
  name        String        @unique
  description String        @default("")
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  lines       GroupLine[]
}

model GroupMember {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

/// Permissões de um grupo num telefone: view, receive, dial, connection, settings, integrations.
model GroupLine {
  groupId     String
  lineId      String
  permissions String[]
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([groupId, lineId])
}

/// Telefone (linha) e sua configuração.
model Line {
  id                   String      @id
  name                 String
  token                String      @unique
  createdAt            DateTime    @default(now())
  inboundMode          String      @default("manual")
  inboundAnswerDelayMs Int         @default(1500)
  maxCallDurationMs    Int         @default(3600000)
  handler              String      @default("silence")
  bridgeUrl            String      @default("ws://127.0.0.1:8090/media")
  bridgeSampleRate     Int         @default(16000)
  allowedOrigins       String[]    @default([])
  /// Webhook: recebe mensagens e eventos de ligação (POST JSON assinado).
  webhookUrl           String      @default("")
  webhookSecret        String      @default("")
  /// Eventos enviados ao webhook (vazio = todos).
  webhookEvents        String[]    @default([])
  /// Limite de mensagens enviadas pelo gateway (0 = sem limite).
  rateLimitPerMinute   Int         @default(20)
  rateLimitPerDay      Int         @default(1000)
  /// Horário de atendimento: { "0": [["08:00","18:00"]], …, "6": [] } (0 = domingo).
  businessHoursEnabled Boolean     @default(false)
  businessHours        Json        @default("{}")
  /// Resposta automática fora do horário (vazio = não responde).
  offHoursMessage      String      @default("")
  /// Recebe/envia mensagens de grupos.
  groupsEnabled        Boolean     @default(false)
  /// Grava as ligações (avise os contatos: exigência da LGPD).
  recordCalls          Boolean     @default(false)
  transcribeCalls      Boolean     @default(false)
  transcribeVoiceNotes Boolean     @default(false)
  /// Números ocultos (só dígitos): gravados, mas fora do painel, da API e do webhook. Só administradores veem.
  hiddenContacts       String[]    @default([])
  /// Chamadas de vídeo recebidas: audio (atende só com áudio) | video (mostra o vídeo do cliente) | reject.
  videoCalls           String      @default("audio")
  groups               GroupLine[]
  calls                Call[]
  messages             Message[]
  webhookDeliveries    WebhookDelivery[]
  contacts             Contact[]
  quickReplies         QuickReply[]
}

/// Histórico de ligações.
model Call {
  id          String    @id @default(cuid())
  callId      String
  lineId      String?
  lineName    String
  direction   String
  remote      String
  remoteJid   String?
  pushName    String?
  handler     String?
  ownerAgent  String?
  ownerUserId String?
  startedAt   DateTime
  connectedAt DateTime?
  endedAt     DateTime?
  endReason   String?
  /// Arquivo da gravação (dentro de DATA_DIR) e duração em segundos.
  recordingFile    String?
  recordingSeconds Int?
  transcript       String?
  /// Transcrição por lado: [{ at: segundos, who: "contact" | "agent", text }].
  transcriptSegments Json?
  line        Line?     @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([lineId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

/// Mensagens (conversas individuais) de cada telefone.
model Message {
  id        String   @id @default(cuid())
  lineId    String
  /// Id da mensagem no WhatsApp.
  waId      String
  direction String
  remote    String
  remoteJid String
  pushName  String?
  type      String
  text      String?
  /// media / location / contact
  extra     Json?
  replyTo   String?
  status    String
  /// Quem enviou pelo gateway (usuário do painel ou "API"); vazio = recebida ou enviada pelo celular.
  agent     String?
  timestamp DateTime
  /// Mensagem do WhatsApp serializada (para baixar a mídia e responder citando).
  raw       String?
  /// Grupos: quem mandou.
  participant     String?
  participantName String?
  editedAt  DateTime?
  deletedAt DateTime?
  /// Transcrição de áudio de voz.
  transcript String?
  createdAt DateTime @default(now())
  line      Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, waId])
  @@index([lineId, remote, timestamp(sort: Desc)])
  @@index([lineId, timestamp(sort: Desc)])
}

/// Fila e histórico de entregas do webhook (sobrevive a reinícios do gateway).
model WebhookDelivery {
  /// Id do evento (o mesmo do campo "id" do corpo).
  id            String    @id
  /// Ordem de envio dentro da linha.
  seq           Int       @default(autoincrement())
  lineId        String
  event         String
  body          String
  /// pending | delivered | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastStatus    Int?
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  line          Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId, status, seq])
  @@index([lineId, createdAt(sort: Desc)])
}

/// Quem fez o quê no painel e na API de gestão.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// super | user | token | system
  actorKind String
  actorId   String?
  actor     String
  /// ex.: line.update, user.create, session.login
  action    String
  lineId    String?
  target    String?
  details   Json?
  ip        String?

  @@index([at(sort: Desc)])
  @@index([lineId, at(sort: Desc)])
  @@index([action, at(sort: Desc)])
}

/// Conversa com um contato (ou grupo) numa linha: dados do atendimento.
model Contact {
  lineId          String
  /// Número (dígitos) ou JID do grupo.
  remote          String
  /// Nome definido pela equipe (sobrepõe o nome do perfil).
  name            String?
  /// Nome salvo na agenda do celular.
  phoneName       String?
  /// Nome do perfil no WhatsApp (pushName).
  pushName        String?
  remoteJid       String?
  notes           String    @default("")
  /// open | pending | resolved
  status          String    @default("open")
  assignedUserId  String?
  assignedName    String?
  lastAutoReplyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  line            Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([lineId, remote])
  @@index([lineId, assignedUserId])
  @@index([lineId, status])
}

/// Resposta rápida ("/atalho" no chat). lineId vazio = vale para todos os telefones.
model QuickReply {
  id        String   @id @default(cuid())
  lineId    String?
  shortcut  String
  text      String
  createdAt DateTime @default(now())
  line      Line?    @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
}

/// Sessão de login no painel (cookie). Guarda só o hash do token.
model Session {
  id        String   @id
  userId    String?
  /// Sessão do super admin (entrou com a ADMIN_API_KEY).
  isSuper   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
