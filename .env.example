# ── Super admin ─────────────────────────────────────────────────
# Chave de acesso do super admin (entra na tela de login em "Entrar com chave de acesso").
# Gere uma longa e aleatória, ex.: openssl rand -base64 32
ADMIN_API_KEY=

# ── Banco de dados (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
POSTGRES_PORT=5432
# Usado ao rodar FORA do Docker (npm start). No Docker o compose monta sozinho.
DATABASE_URL=postgresql://gateway:SENHA@127.0.0.1:5432/gateway?schema=public

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
APP_PORT=3000
# Sessões do WhatsApp dos telefones (fora do Docker). Trate como credencial.
DATA_DIR=./data
# Endereço público do gateway (ex.: https://voz.meusite.com.br). Usado nos links de
# mídia (mediaUrl) enviados ao webhook. Vazio = links relativos (/api/v1/...).
PUBLIC_URL=
# ── HTTPS (perfil "https" do docker-compose, com Caddy) ─────────
# DOMAIN=voz.suaempresa.com.br       (DNS apontando para este servidor, portas 80 e 443 livres)
# PUBLIC_URL=https://voz.suaempresa.com.br
# SECURE_COOKIES=true
# TRUST_PROXY=true                   (usa o IP real do cliente vindo do Caddy)
# APP_BIND=127.0.0.1                 (porta 3000 só acessível pelo Caddy)
DOMAIN=
TRUST_PROXY=false
APP_BIND=0.0.0.0
# "true" quando estiver atrás de HTTPS (cookie de sessão com flag Secure)
SECURE_COOKIES=false
# ── Operação ────────────────────────────────────────────────────
# Alertas (telefone caiu, webhook falhando): URL de webhook do Slack, Discord ou similar.
ALERT_WEBHOOK_URL=
# "json" para logs estruturados (uma linha JSON por evento).
LOG_FORMAT=
# Cache de mídia das mensagens: dias sem uso e tamanho máximo (MB). 0 = sem limite.
MEDIA_CACHE_DAYS=30
MEDIA_CACHE_MAX_MB=5120
# Dias que as gravações de ligação são mantidas (0 = para sempre).
RECORDINGS_DAYS=0
# Dias que o log de auditoria é mantido.
AUDIT_DAYS=365
# "true" permite baixar mídia/áudio de endereços da rede interna (por padrão bloqueado).
ALLOW_PRIVATE_URLS=false
# Fuso horário (horário de atendimento, limites diários, métricas).
TZ=America/Sao_Paulo

# ── Transcrição (gravações e áudios de voz) ─────────────────────
# API compatível com OpenAI /v1/audio/transcriptions (OpenAI, Groq, whisper local…).
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt

# Diagnóstico de chamadas: 1 ou wasm
VOIP_DEBUG=
