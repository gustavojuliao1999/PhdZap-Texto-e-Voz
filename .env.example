# ── Super admin ─────────────────────────────────────────────────
# Chave de acesso do super admin (entra na tela de login em "Entrar com chave de acesso").
# Gere uma longa e aleatória, ex.: openssl rand -base64 32
ADMIN_API_KEY=

# ── Banco de dados (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
POSTGRES_PORT=5432
# Usado ao rodar FORA do Docker (npm start). No Docker o compose monta sozinho.
DATABASE_URL=postgresql://gateway:SENHA@127.0.0.1:5432/gateway?schema=public

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
APP_PORT=3000
# Sessões do WhatsApp dos telefones (fora do Docker). Trate como credencial.
DATA_DIR=./data
# Endereço público do gateway (ex.: https://voz.meusite.com.br). Usado nos links de
# mídia (mediaUrl) enviados ao webhook. Vazio = links relativos (/api/v1/...).
PUBLIC_URL=
# ── HTTPS (proxy reverso por sua conta; veja "HTTPS" no README) ─
# PUBLIC_URL=https://voz.suaempresa.com.br
# SECURE_COOKIES=true
# TRUST_PROXY=true                   (usa o IP real do cliente do X-Forwarded-For)
# APP_BIND=127.0.0.1                 (porta 3000 acessível só pelo proxy)
TRUST_PROXY=false
APP_BIND=0.0.0.0
# docker-compose.https.yml (Caddy). DOMAIN aceita vários, separados por vírgula:
# domínio público = Let's Encrypt; localhost/IP da rede = certificado interno (dev).
DOMAIN=localhost
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Porta de dev (app direto em HTTP). 0.0.0.0 abre para a rede, sem HTTPS.
DEV_BIND=127.0.0.1
DEV_PORT=3000
# "true" quando estiver atrás de HTTPS (cookie de sessão com flag Secure)
SECURE_COOKIES=false
# ── Operação ────────────────────────────────────────────────────
# Alertas (telefone caiu, webhook falhando): URL de webhook do Slack, Discord ou similar.
ALERT_WEBHOOK_URL=
# "json" para logs estruturados (uma linha JSON por evento).
LOG_FORMAT=
# Cache de mídia das mensagens: dias sem uso e tamanho máximo (MB). 0 = sem limite.
MEDIA_CACHE_DAYS=30
MEDIA_CACHE_MAX_MB=5120
# Dias que as gravações de ligação e os áudios das conversas são mantidos (0 = para sempre).
RECORDINGS_DAYS=0
# Dias que o log de auditoria é mantido.
AUDIT_DAYS=365
# "true" permite baixar mídia/áudio de endereços da rede interna (por padrão bloqueado).
ALLOW_PRIVATE_URLS=false
# Fuso horário (horário de atendimento, limites diários, métricas).
TZ=America/Sao_Paulo

# ── Transcrição de áudio para texto (DESLIGADA por padrão) ─────
# Transcreve as ligações (separando cliente e atendente) e os áudios de voz das conversas.
# O áudio é sempre guardado, com a transcrição ligada ou não.
#   off   = desligada
#   local = whisper.cpp dentro do próprio container (sem serviço externo; o modelo é
#           baixado na primeira vez para DATA_DIR/models)
#   api   = API compatível com OpenAI (TRANSCRIBE_API_URL / TRANSCRIBE_API_KEY abaixo)
TRANSCRIBE=off

# Modelo. Para TRANSCRIBE=local, escolha um (tamanho do arquivo · RAM aproximada · servidor sugerido):
#   tiny                  75 MB · ~0,4 GB · 1 vCPU   fraco em português
#   base                 142 MB · ~0,5 GB · 1 vCPU   razoável
#   small-q5_1           181 MB · ~0,7 GB · 2 vCPU   bom, leve        ← servidor barato
#   small                466 MB · ~1 GB   · 2 vCPU   bom
#   medium-q5_0          514 MB · ~1,5 GB · 4 vCPU   muito bom
#   large-v3-turbo-q5_0  547 MB · ~1,5 GB · 4 vCPU   ótimo            ← melhor custo-benefício com 4 vCPU
#   large-v3-turbo       1,5 GB · ~2,5 GB · 4+ vCPU  ótimo
#   large-v3             2,9 GB · ~4 GB   · 8 vCPU   o melhor, lento sem GPU
#   (ou o caminho de um arquivo .bin do whisper.cpp)
# Para TRANSCRIBE=api: whisper-1 (OpenAI), whisper-large-v3-turbo (Groq)…
#TRANSCRIBE_MODEL=small-q5_1
TRANSCRIBE_LANGUAGE=pt
# Só local: núcleos usados (vazio = todos; roda com prioridade baixa para não atrapalhar as ligações).
#TRANSCRIBE_THREADS=
# Só api:
#TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
#TRANSCRIBE_API_KEY=

# Diagnóstico de chamadas: 1 ou wasm
VOIP_DEBUG=
