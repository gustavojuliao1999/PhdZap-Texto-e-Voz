# Porta/host do painel, da API e dos iframes
PORT=3000
HOST=127.0.0.1

# Chave de acesso do painel e da API admin. Se vazio, uma é gerada no 1º start
# e salva em DATA_DIR/admin.json (aparece no terminal).
ADMIN_API_KEY=

# Onde ficam linhas, sessões do WhatsApp e histórico. Trate como credencial.
DATA_DIR=./data

# "true" quando estiver atrás de HTTPS (cookie de sessão com flag Secure)
SECURE_COOKIES=false
