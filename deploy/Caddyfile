# HTTPS automático (Let's Encrypt) na frente do gateway.
# Usado pelo perfil "https" do docker-compose: DOMAIN=voz.suaempresa.com.br
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# WebSockets (eventos, áudio) passam direto.
	reverse_proxy app:3000
}
