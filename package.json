{
  "name": "whatsapp-voice-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway de chamadas de voz do WhatsApp (entrada/saída) sobre o baileys-caller, com ponte de mídia em tempo real para agentes de IA.",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "bridge:example": "tsx examples/echo-bridge-server.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "baileys-caller": "file:../baileys-caller",
    "marked": "^16.4.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
